# Configuracion de la instalacion de un cliente. instalar.sh crea produccion/.env a partir de este
# fichero y genera las contraseñas. No subas .env al repositorio.

# Direccion de la app (ver el Caddyfile del front):
#   trazabilidad.cliente.com  -> HTTPS con Let's Encrypt (el dominio debe apuntar a este servidor)
#   192.168.1.50              -> HTTPS con la CA propia de Caddy (solo en la red de la planta)
#   :80                       -> solo HTTP, para probar
DOMINIO=trazabilidad.cliente.com

# Generadas por instalar.sh (openssl rand -hex 32). No las cambies con la base de datos ya creada.
DB_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=

# Copias de seguridad (backup.sh): dias que se guardan en el servidor y, opcional,
# un destino de rclone donde copiar cada copia fuera del servidor (p. ej. remoto:gargantapp-cliente)
DIAS_COPIAS=30
DESTINO_REMOTO=
